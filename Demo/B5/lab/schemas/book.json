{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library Book (Input)",
  "type": "object",
  "required": ["title"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "isbn": {
      "type": "string",
      "pattern": "^\\d{13}$"
    },
    "published_year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 2100
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "total_copies": {
      "type": "integer",
      "minimum": 0
    },
    "category_id": {
      "type": "integer"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/author_ref"
      }
    }
  },
  "$defs": {
    "author_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["lead", "co", "translator"]
        }
      }
    }
  }
}